# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # segredo. nunca com prefixo NEXT_PUBLIC_

# ---- Endereço do site (usado nos links dos e-mails) ----
NEXT_PUBLIC_SITE_URL=https://multimidia.seudominio.com.br

# ---- E-mail (resend.com) ----
RESEND_API_KEY=re_...
EMAIL_REMETENTE="Ministério de Multimídia <multimidia@seudominio.com.br>"

# ---- WhatsApp ----
# Escolha 'cloud' (oficial da Meta), 'evolution' (self-hosted) ou 'off'
WHATSAPP_PROVIDER=off

# se WHATSAPP_PROVIDER=cloud
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_TEMPLATE_APROVADO=inscricao_aprovada
WHATSAPP_TEMPLATE_RECUSADO=inscricao_recusada
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# se WHATSAPP_PROVIDER=evolution
EVOLUTION_URL=http://localhost:8080
EVOLUTION_INSTANCE=multimidia
EVOLUTION_APIKEY=sua-chave

# DDI usado quando a pessoa digita só o número local
TELEFONE_DDI=55
